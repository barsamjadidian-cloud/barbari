# Database
DATABASE_URL="file:./data.db"
DATABASE_PROVIDER="sqlite"

# Auth
NEXTAUTH_SECRET="change-me-32-chars-minimum-secure-secret"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="another-super-secret-jwt-key-change-me"

# Payments - abstract layer, plug any gateway via env
PAYMENT_PROVIDER="zarinpal" # zarinpal | stripe | mock
ZARINPAL_MERCHANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
ZARINPAL_SANDBOX="true"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
PAYMENT_MOCK_SUCCESS_RATE="0.95"

# Email & SMS notifications (configurable)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@barbari.coffee"
SMTP_PASS="..."
SMS_PROVIDER="kavenegar" # kavenegar | twilio | mock
KAVENEGAR_API_KEY="..."
TWILIO_SID="..."
TWILIO_TOKEN="..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="BARBARI"
